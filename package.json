{
  "name": "hall-of-artisans",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/workflow-contract-check.mjs && node scripts/staff-workspace-contract-check.mjs && node scripts/auth-return-contract-check.mjs && node scripts/request-chat-live-contract-check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "playwright test e2e/live-role-handoff.spec.ts",
    "test:workflow": "node scripts/workflow-contract-check.mjs",
    "test:staff": "node scripts/staff-workspace-contract-check.mjs",
    "test:chat": "node scripts/request-chat-live-contract-check.mjs",
    "test:academy:foundation": "node scripts/academy-foundation-check.mjs",
    "test:academy:phase1": "node scripts/academy-phase1-contract-check.mjs",
    "test:academy:phase2": "node scripts/academy-phase2-contract-check.mjs",
    "test:academy:reader": "node scripts/academy-lesson-reader-contract-check.mjs",
    "test:e2e:academy": "playwright test e2e/academy-foundation.spec.ts",
    "test:beta": "node scripts/beta-readiness-check.mjs && pnpm test && pnpm build",
    "test:release": "pnpm test:beta && pnpm test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
